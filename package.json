{
  "name": "nst3",
  "version": "0.0.1-pre.0",
  "description": "Production-grade VST3 host for Node.js — load, automate, and process audio through any VST3 plugin with zero-copy buffers and prebuilt native binaries.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "author": "Henley Sun <Henley04@users.noreply.github.com>",
  "homepage": "https://github.com/Henley04/nst3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Henley04/nst3.git"
  },
  "bugs": {
    "url": "https://github.com/Henley04/nst3/issues"
  },
  "keywords": [
    "vst",
    "vst3",
    "audio",
    "dsp",
    "host",
    "plugin",
    "native",
    "midi",
    "synth",
    "effect"
  ],
  "engines": {
    "node": ">=16.17"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "prebuilds/",
    "binding.gyp",
    "src/",
    "third_party/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "binary": {
    "module_name": "nst3",
    "module_path": "./"
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp configure && node-gyp build",
    "rebuild": "node-gyp rebuild",
    "clean": "node-gyp clean",
    "prebuild": "prebuildify --napi-version 8 --tag-armv -t 20.0.0",
    "test": "node --test test/discovery.test.js test/errors.test.js test/load.test.js test/lifecycle.test.js test/midi.test.js test/parameters.test.js test/process.test.js test/state.test.js",
    "test:plugin": "node test/plugin/build-plugin.js"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp": "^12.4.0",
    "prebuildify": "^6.0.1"
  }
}
